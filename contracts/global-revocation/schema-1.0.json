{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-agnostic-secret-scanner:global-revocation:1.0",
  "title": "Global Scanner Revocation Marker 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["revocationSchemaVersion", "markerId", "sequence", "targetType", "targetDigest", "issuedAt", "effectiveAt", "reasonCode", "authorityId"],
  "properties": {
    "revocationSchemaVersion": { "type": "string", "const": "1.0" },
    "markerId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousMarkerDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetType": { "type": "string", "enum": ["scanner-release", "scanner-asset", "rule-pack", "scanner-schema"] },
    "targetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "reasonCode": { "type": "string", "enum": ["COMPROMISE", "INTEGRITY_DEFECT", "INCOMPLETE_COVERAGE", "AUTHORITY_DEFECT", "RETIREMENT_BREACH"] },
    "authorityId": { "type": "string", "pattern": "^[A-Za-z0-9._:/+-]{1,128}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "sequence": { "minimum": 2 } }, "required": ["sequence"] },
      "then": { "required": ["previousMarkerDigest"] }
    },
    {
      "if": { "properties": { "sequence": { "const": 1 } }, "required": ["sequence"] },
      "then": { "not": { "required": ["previousMarkerDigest"] } }
    }
  ]
}
